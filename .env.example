DATABASE_URL=""

# 32-byte key, base64. Rotate via PHI_KEY_PREVIOUS when rolling.
PHI_ENC_KEY=""
SESSION_SECRET=""

# Stripe test mode. Leave blank to run billing in simulated mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# Demo only. Shows the email verification code on screen because no mail
# transport is wired up. Never set this on a deployment with real patients;
# setting MAIL_FROM disables it regardless.
# Set to false only when serving the demo over plain http. A browser will not
# store a Secure cookie on an http origin, which looks exactly like a broken
# login. Anything behind TLS should leave this unset.
COOKIE_SECURE=""

SHOW_VERIFICATION_CODE=""
MAIL_FROM=""

# Local object storage root (S3 in production)
UPLOAD_DIR=""
